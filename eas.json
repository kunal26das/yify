{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "autoIncrement": false,
      "env": {
        "EXPO_UPDATE_CHANNEL": "Production"
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      },
      "ios": {
        "simulator": true
      }
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": false,
      "env": {
        "EXPO_UPDATE_CHANNEL": "Staging"
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": false,
      "env": {
        "EXPO_UPDATE_CHANNEL": "Production"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "${YIFY_RELEASE_PLAY_SERVICE_ACCOUNT:-$HOME/.config/play-publisher/yify-service-account.json}",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "play-production": {
      "extends": "production",
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
