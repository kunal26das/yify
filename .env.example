# Firebase client overrides. Copy to .env and fill from Firebase Console → Project settings.
# Omitting these keeps the app's existing Yify Firebase defaults.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google sign-in on Android/iOS. Firebase Console → Authentication → Sign-in method → Google,
# then add your signing SHA-1 under Project settings and re-download google-services.json.
# This is the OAuth client of type 3 (web client) inside that file.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat. Sign-in ties the Firebase uid to the RevenueCat app user id.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_KEY=

# EAS Hosting server only. Configure with sensitive visibility in the production environment.
YIFY_SUBSCRIBER_FIREBASE_PROJECT_ID=yify-2da67
YIFY_SUBSCRIBER_REVENUECAT_API_KEY=
YIFY_SUBSCRIBER_REVENUECAT_PRODUCT_IDS=prod4a474db633,prod3b9edb236c
