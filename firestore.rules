rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isSyncPayload(data) {
      return data.keys().hasOnly([
               'watchlist',
               'watchlistUpdatedAt',
               'preferences',
               'preferencesUpdatedAt'
             ])
             && (!('watchlist' in data)
                 || (data.watchlist is string && data.watchlist.size() <= 500000))
             && (!('preferences' in data)
                 || (data.preferences is string && data.preferences.size() <= 4000))
             && (!('watchlistUpdatedAt' in data) || data.watchlistUpdatedAt is int)
             && (!('preferencesUpdatedAt' in data) || data.preferencesUpdatedAt is int);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isSyncPayload(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
