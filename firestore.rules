rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isSyncPayload(data) {
      return data.keys().hasOnly([
               'watchlist',
               'watchlistUpdatedAt',
               'preferences',
               'preferencesUpdatedAt',
               'history',
               'historyUpdatedAt',
               'library',
               'libraryUpdatedAt',
               'availabilityAlerts'
             ])
             && (!('watchlist' in data)
                 || (data.watchlist is string && data.watchlist.size() <= 500000))
             && (!('preferences' in data)
                 || (data.preferences is string && data.preferences.size() <= 4000))
             && (!('history' in data)
                 || (data.history is string && data.history.size() <= 150000))
             && (!('library' in data)
                 || (data.library is string && data.library.size() <= 300000))
             && (!('availabilityAlerts' in data)
                 || (data.availabilityAlerts is string && data.availabilityAlerts.size() <= 16000))
             && (!('libraryUpdatedAt' in data) || data.libraryUpdatedAt is int)
             && (!('watchlistUpdatedAt' in data) || data.watchlistUpdatedAt is int)
             && (!('preferencesUpdatedAt' in data) || data.preferencesUpdatedAt is int)
             && (!('historyUpdatedAt' in data) || data.historyUpdatedAt is int);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isSyncPayload(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /journals/{uid} {
      function validJournal() {
        return request.resource.data.keys().hasOnly(['payload', 'updatedAt', 'deleting'])
          && request.resource.data.keys().hasAll(['payload', 'updatedAt', 'deleting'])
          && request.resource.data.payload is string
          && request.resource.data.payload.toUtf8().size() <= 400000
          && request.resource.data.updatedAt is int
          && request.resource.data.updatedAt > 0
          && request.resource.data.deleting is bool
          && (!request.resource.data.deleting
              || request.resource.data.payload == '{"version":1,"clearedAt":0,"entries":{}}');
      }
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validJournal();
      allow update: if isOwner(uid) && !resource.data.deleting && validJournal();
      // Deletion is an empty immutable marker: stale devices cannot recreate private entries.
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
