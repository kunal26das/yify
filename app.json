{
  "expo": {
    "name": "Yify",
    "slug": "yify",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "yify",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.kunal26das.yify",
      "associatedDomains": [
        "applinks:yify.expo.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D97757",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.kunal26das.yify",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "yify.expo.app",
              "pathPrefix": "/movie"
            },
            {
              "scheme": "https",
              "host": "yify.expo.app",
              "pathPrefix": "/show"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false,
          "headOrigin": "https://yify.expo.app",
          "headers": {
            "X-Content-Type-Options": "nosniff",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#D97757",
          "dark": {
            "backgroundColor": "#D97757"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "./plugins/withCrashlyticsNdk",
      "@react-native-firebase/auth",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "kudos-labs",
          "project": "react-native",
          "experimental_android": {
            "enableAndroidGradlePlugin": true,
            "includeNativeSources": false,
            "includeSourceContext": false
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "./plugins/withAndroidRelease",
      "./plugins/withGradleJvmArgs",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2292299294214510~5237171305",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      "./plugins/withGwpAsan",
      "expo-updates",
      "expo-localization",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D97757"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.worklets.** { *; }\n-keep class com.margelo.nitro.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.google.android.gms.internal.consent_sdk.** { *; }\n-keepattributes SourceFile,LineNumberTable\n-keepattributes *Annotation*\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "130cfded-cef0-49b3-94a4-82d3a3852ef5"
      }
    }
  }
}
