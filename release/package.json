{
  "name": "yify-release-console",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive TUI/GUI for store releases and EAS Update rollouts, with login + runtime-version guardrails.",
  "type": "module",
  "main": "dist/presentation/gui/main.js",
  "scripts": {
    "tui": "tsx presentation/tui/index.tsx",
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "node dist/scripts/copyAssets.js",
    "gui": "npm run build && electron dist/presentation/gui/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'domain/**/*.test.ts' 'data/**/*.test.ts' 'presentation/**/*.test.ts'"
  },
  "dependencies": {
    "app-info-parser": "1.1.6",
    "eas-cli": "24.7.0",
    "ink": "7.1.1",
    "ink-select-input": "6.2.0",
    "ink-text-input": "6.0.0",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "electron": "44.4.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "resolutions": {
    "protobufjs": "7.6.6",
    "adm-zip": "0.6.1",
    "parse-duration": "2.1.9",
    "uuid": "11.1.1",
    "esbuild": "0.28.2",
    "tar": "7.5.22",
    "joi": "17.13.8",
    "yaml": "2.9.1",
    "ajv": "8.20.0",
    "eas-cli/minimatch": "5.1.9",
    "nanoid": "3.3.19",
    "diff": "8.0.4",
    "ts-deepmerge": "8.0.0"
  }
}
