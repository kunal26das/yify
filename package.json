{
  "name": "yify",
  "main": "entry.ts",
  "version": "1.8.10",
  "versionCode": 92,
  "private": true,
  "workspaces": [
    "crashreporting",
    "tooling"
  ],
  "scripts": {
    "start": "NODE_OPTIONS=--max-old-space-size=8192 CI=false expo start",
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 CI=false expo start --dev-client",
    "android": "NODE_OPTIONS=--max-old-space-size=8192 expo run:android",
    "android:debug": "bash scripts/run-android-debug.sh",
    "android:release": "bash scripts/run-android-release.sh",
    "ios": "NODE_OPTIONS=--max-old-space-size=8192 CI=false DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer expo run:ios",
    "ios:start": "NODE_OPTIONS=--max-old-space-size=8192 CI=false DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer expo start --ios",
    "web": "NODE_OPTIONS=--max-old-space-size=8192 CI=false expo start --web",
    "export:web": "NODE_OPTIONS=--max-old-space-size=8192 EXPO_WEB_OUTPUT=static EXPO_WEB_BASE_URL=/yify expo export --platform web --clear --source-maps",
    "export:desktop": "NODE_OPTIONS=--max-old-space-size=8192 EXPO_WEB_OUTPUT=static EXPO_WEB_BASE_URL='' expo export --platform web",
    "export:hosting": "NODE_OPTIONS=--max-old-space-size=8192 EXPO_WEB_OUTPUT=server EXPO_WEB_BASE_URL='' expo export --platform web --clear --source-maps --output-dir dist-hosting",
    "desktop": "yarn export:desktop && electron desktop/main.js",
    "desktop:dev": "electron desktop/main.js",
    "desktop:build": "yarn export:desktop && electron-builder --mac",
    "desktop:build:all": "yarn export:desktop && electron-builder --mac --win --linux",
    "lint": "expo lint app data domain presentation",
    "prebuild": "expo prebuild",
    "test": "node --test 'domain/**/*.test.ts' 'data/**/*.test.ts' 'presentation/player/youtubeWebView.test.ts' 'tests/**/*.test.cjs' 'scripts/availability-alerts/worker.test.mjs' && yarn test:crashreporting",
    "typecheck": "tsc --noEmit && yarn workspace @yify/crashreporting typecheck",
    "eas": "bash scripts/eas.sh",
    "build:dev:android": "bash scripts/eas.sh build --platform android --profile development",
    "build:dev:ios": "bash scripts/eas.sh build --platform ios --profile development",
    "build:dev:ios:device": "bash scripts/eas.sh build --platform ios --profile development-device",
    "build:preview:android": "bash scripts/eas.sh build --platform android --profile preview",
    "build:production:android": "bash scripts/eas.sh build --platform android --profile production",
    "submit:android": "bash scripts/eas.sh submit --platform android --profile production",
    "submit:android:play": "bash scripts/eas.sh submit --platform android --profile play-production",
    "deploy:hosting": "yarn export:hosting && node scripts/check-web-export.mjs dist-hosting --server && bash scripts/eas.sh deploy --export-dir dist-hosting --environment production",
    "deploy:hosting:prod": "yarn export:hosting && node scripts/check-web-export.mjs dist-hosting --server && bash scripts/eas.sh deploy --export-dir dist-hosting --environment production --prod",
    "test:crashreporting": "yarn workspace @yify/crashreporting test",
    "release": "cd release && yarn gui",
    "postinstall": "node scripts/expo-native-compat.mjs && node scripts/apply-tooling-compatibility.mjs && node scripts/query-string-compat.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/hanken-grotesk": "0.4.3",
    "@expo-google-fonts/lora": "0.4.2",
    "@expo/log-box": "58.0.4",
    "@expo/metro-runtime": "58.0.6",
    "@expo/ui": "58.0.6",
    "@expo/vector-icons": "15.1.1",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-firebase/analytics": "26.4.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/auth": "26.4.0",
    "@react-native-firebase/crashlytics": "26.4.0",
    "@react-native-firebase/remote-config": "26.4.0",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@revenuecat/purchases-js": "1.63.1",
    "@sentry/react-native": "8.27.0",
    "@xmldom/xmldom": "0.9.12",
    "@yify/crashreporting": "0.1.0",
    "expo": "58.0.0-preview.6",
    "expo-background-task": "58.0.6",
    "expo-blur": "58.0.1",
    "expo-build-properties": "58.0.6",
    "expo-constants": "58.0.6",
    "expo-dev-client": "58.0.6",
    "expo-device-corner-radius": "0.1.1",
    "expo-font": "58.0.2",
    "expo-glass-effect": "58.0.2",
    "expo-haptics": "58.0.1",
    "expo-image": "58.0.5",
    "expo-in-app-updates": "0.12.0",
    "expo-insights": "58.0.6",
    "expo-keep-awake": "58.0.1",
    "expo-linking": "58.0.6",
    "expo-localization": "58.0.1",
    "expo-location": "58.0.6",
    "expo-navigation-bar": "58.0.1",
    "expo-network": "58.0.1",
    "expo-notifications": "58.0.6",
    "expo-router": "58.0.7",
    "expo-splash-screen": "58.0.1",
    "expo-sqlite": "58.0.5",
    "expo-status-bar": "58.0.1",
    "expo-store-review": "58.0.0",
    "expo-symbols": "58.0.2",
    "expo-system-ui": "58.0.2",
    "expo-task-manager": "58.0.7",
    "expo-updates": "58.0.8",
    "expo-web-browser": "58.0.2",
    "firebase": "12.19.0",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-google-mobile-ads": "17.1.0",
    "react-native-purchases": "10.10.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "5.10.0",
    "react-native-screens": "4.28.0",
    "react-native-web": "0.21.2",
    "react-native-web-webview": "1.0.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-native-youtube-iframe": "2.4.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@react-native/metro-config": "0.88.0-rc.1",
    "@types/react": "19.3.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "error-stack-parser": "2.1.4",
    "eslint": "10.11.0",
    "eslint-config-expo": "58.0.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "expo-doctor": "1.20.4",
    "react-test-renderer": "19.3.0",
    "typescript": "7.0.2",
    "@babel/preset-typescript": "8.0.1",
    "@babel/preset-react": "8.0.1",
    "@babel/plugin-transform-modules-commonjs": "8.0.1",
    "@babel/plugin-transform-dynamic-import": "8.0.1",
    "@react-native/js-polyfills": "0.88.0-rc.1"
  },
  "resolutions": {
    "**/xcode/uuid": "11.1.1",
    "@yify/tooling/**/ts-api-utils": "2.5.0",
    "**/query-string/decode-uri-component": "0.5.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          ".*"
        ]
      }
    }
  }
}
