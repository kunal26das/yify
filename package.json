{
  "name": "yify",
  "main": "expo-router/entry",
  "version": "1.4.9",
  "versionCode": 56,
  "private": true,
  "scripts": {
    "start": "NODE_OPTIONS=--max-old-space-size=8192 CI=false expo start",
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 CI=false expo start --dev-client",
    "android": "NODE_OPTIONS=--max-old-space-size=8192 expo run:android",
    "android:debug": "bash scripts/run-android-debug.sh",
    "android:release": "bash scripts/run-android-release.sh",
    "ios": "NODE_OPTIONS=--max-old-space-size=8192 CI=false DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer expo run:ios",
    "ios:start": "NODE_OPTIONS=--max-old-space-size=8192 CI=false DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer expo start --ios",
    "web": "NODE_OPTIONS=--max-old-space-size=8192 CI=false expo start --web",
    "export:web": "NODE_OPTIONS=--max-old-space-size=8192 EXPO_WEB_BASE_URL=/yify expo export --platform web",
    "export:desktop": "NODE_OPTIONS=--max-old-space-size=8192 EXPO_WEB_BASE_URL='' expo export --platform web",
    "export:hosting": "NODE_OPTIONS=--max-old-space-size=8192 EXPO_WEB_BASE_URL='' expo export --platform web --clear --output-dir dist-hosting",
    "desktop": "yarn export:desktop && electron desktop/main.js",
    "desktop:dev": "electron desktop/main.js",
    "desktop:build": "yarn export:desktop && electron-builder --mac",
    "desktop:build:all": "yarn export:desktop && electron-builder --mac --win --linux",
    "lint": "expo lint app data domain presentation",
    "prebuild": "expo prebuild",
    "postinstall": "patch-package",
    "test": "node --test 'domain/**/*.test.ts' 'data/**/*.test.ts'",
    "eas": "bash scripts/eas.sh",
    "build:dev:android": "bash scripts/eas.sh build --platform android --profile development",
    "build:dev:ios": "bash scripts/eas.sh build --platform ios --profile development",
    "build:dev:ios:device": "bash scripts/eas.sh build --platform ios --profile development-device",
    "build:preview:android": "bash scripts/eas.sh build --platform android --profile preview",
    "build:production:android": "bash scripts/eas.sh build --platform android --profile production",
    "submit:android": "bash scripts/eas.sh submit --platform android --profile production",
    "submit:android:play": "bash scripts/eas.sh submit --platform android --profile play-production",
    "deploy:hosting": "yarn export:hosting && bash scripts/eas.sh deploy --export-dir dist-hosting --environment production",
    "deploy:hosting:prod": "yarn export:hosting && bash scripts/eas.sh deploy --export-dir dist-hosting --environment production --prod",
    "release": "cd release && yarn gui"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "0.4.1",
    "@expo-google-fonts/hanken-grotesk": "0.4.3",
    "@expo/log-box": "57.0.2",
    "@expo/metro-runtime": "57.0.8",
    "@expo/ui": "57.0.10",
    "@expo/vector-icons": "15.0.2",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-firebase/analytics": "24.1.1",
    "@react-native-firebase/app": "24.1.1",
    "@react-native-firebase/auth": "24.1.1",
    "@react-native-firebase/crashlytics": "24.1.1",
    "@react-native-firebase/remote-config": "24.1.1",
    "@react-native-google-signin/google-signin": "16.1.4",
    "@revenuecat/purchases-js": "1.52.0",
    "expo": "57.0.12",
    "expo-background-task": "57.0.8",
    "expo-blur": "57.0.2",
    "expo-build-properties": "57.0.10",
    "expo-constants": "57.0.11",
    "expo-dev-client": "57.0.11",
    "expo-device-corner-radius": "0.1.1",
    "expo-font": "57.0.1",
    "expo-glass-effect": "57.0.1",
    "expo-image": "57.0.2",
    "expo-in-app-updates": "0.12.0",
    "expo-insights": "57.0.9",
    "expo-linking": "57.0.5",
    "expo-notifications": "57.0.10",
    "expo-router": "57.0.11",
    "expo-splash-screen": "57.0.6",
    "expo-status-bar": "57.0.1",
    "expo-store-review": "57.0.1",
    "expo-symbols": "57.0.2",
    "expo-system-ui": "57.0.2",
    "expo-task-manager": "57.0.9",
    "expo-updates": "57.0.12",
    "expo-web-browser": "57.0.2",
    "firebase": "12.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "3.1.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.36.5",
    "react-native-purchases": "10.7.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "5.8.1",
    "react-native-screens": "4.27.0",
    "react-native-web": "0.21.2",
    "react-native-web-webview": "1.0.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.11.3",
    "react-native-youtube-iframe": "2.4.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.3",
    "eslint-config-expo": "57.0.1",
    "eslint-import-resolver-typescript": "3.10.1",
    "patch-package": "8.0.1",
    "postinstall-postinstall": "2.1.0",
    "typescript": "7.0.2"
  },
  "resolutions": {
    "**/xcode/uuid": "11.1.1"
  }
}
